# Copy to .env and replace every CHANGE_ME value.
# Generate the master key with:
#   openssl rand -base64 32
T5_DB_DSN=t5:CHANGE_ME_DB_PASSWORD@tcp(mysql:3306)/t5?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true
T5_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
T5_PAIRING_TTL=30s
T5_LOG_LEVEL=info

# Required only with the bundled-db profile.
MYSQL_DATABASE=t5
MYSQL_USER=t5
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Required only with the https profile.
T5_DOMAIN=t5.example.com
